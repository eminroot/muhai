# Frontend environment. Copy to .env.local (git-ignored) and adjust.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# anything set here is PUBLIC once built. Do not put secrets in it.

# The Muhai API. Everything the app does goes through it: sessions, company
# data, and everything that is *calculated* — the 2026 tax engine, the Muhai
# Score, Prophet forecasting, payroll, OCR and the assistant.
#
# Leave it empty for a Docker/production build: the app and the API share one
# origin there and nginx proxies /api to the backend. The Vite dev server does
# not, so development points at the API's own port.
VITE_API_URL=http://localhost:8000
