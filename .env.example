# ============================================================
# Muhai — Docker Compose environment.
#
#     cp .env.example .env
#     openssl rand -hex 32        # paste into SECRET_KEY
#
# Compose reads this file automatically. It is the single place the whole
# stack is configured; the containers get no other configuration.
#
# .env is git-ignored. Never commit a filled-in copy.
# ============================================================

# ── Required ───────────────────────────────────────────────────────────
# Sessions are signed with this. Compose refuses to start without it.
# Changing it on a running deployment signs every user out.
SECRET_KEY=

# ── Sign in with Google ────────────────────────────────────────────────
# The Firebase project whose ID tokens /api/auth/google will accept. It must
# be the SAME project the web app is built with, or every sign-in fails the
# audience check. This is a public identifier, not a secret: verification uses
# Google's published certificates, so no service-account key is stored here.
# Leave empty to switch Google sign-in off — the endpoint then answers 503 and
# the button disappears from the auth screens.
FIREBASE_PROJECT_ID=cyberxbank-7dc0b

# The browser half. These are Firebase's public client identifiers and ship in
# the bundle by design; they authorise nothing on their own. Defaults for this
# project are compiled in, so these only need setting to point a fork at a
# different Firebase project. Build-time only — changing them needs a rebuild.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# In the Firebase console this needs two things switched on, or the button
# fails at the Google step before it ever reaches Muhai:
#   Authentication → Sign-in method → Google → Enable
#   Authentication → Settings → Authorised domains → add your deployed domain
#     (localhost is there by default, so development works out of the box)

# ── Database ───────────────────────────────────────────────────────────
# Used both to initialise Postgres and to build the API's DATABASE_URL.
# Change the password before the first `up`: after the volume is created,
# changing it here no longer changes the password inside the database.
POSTGRES_USER=muhai
POSTGRES_PASSWORD=muhai_secret
POSTGRES_DB=muhai

# ── Web ────────────────────────────────────────────────────────────────
# The only published port. Put a TLS terminator in front of it on the VPS
# (see docs/DEPLOY.md) and set this to 8080 so nginx or Caddy can own :80.
WEB_PORT=80

# Leave empty. The browser then calls /api on its own origin and the web
# container's nginx proxies it to the backend — no CORS, no API hostname
# baked into the bundle. Set it only if the API runs on a different host.
VITE_API_URL=

# ── API ────────────────────────────────────────────────────────────────
# uvicorn workers. Roughly one per CPU core; 2 suits a small VPS.
API_WORKERS=2

# Only needed when the browser is served from an origin the API does not
# share — i.e. the Vite dev server, or a split deployment. With the nginx
# proxy above, production needs nothing here.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# /api/compute reads no table but still requires a signed-in caller.
# Set false ONLY for an offline demo on a machine nobody else can reach.
COMPUTE_AUTH_REQUIRED=true

# ── AI ─────────────────────────────────────────────────────────────────
# Server-side assistant. Empty is a supported configuration: the assistant
# falls back to the local BM25 knowledge base and says so in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=

# Tesseract languages for server-side OCR.
# Turkish alone reads Turkish invoices better than "tur+eng" and is faster.
OCR_LANG=tur
