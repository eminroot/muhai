.env

# --- web frontend ---
node_modules
dist
dist-ssr
*.local
.env.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- backend ---
backend/.env
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# --- editors / os ---
.DS_Store
.vscode/*
!.vscode/extensions.json

# --- database dumps ---
